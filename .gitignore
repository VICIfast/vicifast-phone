# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing — NEVER commit these
android/key.properties
android/app/*.jks
android/app/*.keystore
**/google-services.json

# iOS signing — NEVER commit these
ios/Runner/GoogleService-Info.plist
ios/certs/
*.p12
*.mobileprovision
*.cer

# CocoaPods (regenerated by `pod install`)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Environment / local config
.env

# API codegen — source of truth lives at packages/api-types/openapi.json.
# `pnpm mobile:codegen` copies it here as a build_runner input, then
# emits generated Dart into lib/src/api/generated/. Both directions are
# regenerated, never hand-edited, so neither belongs in git.
lib/api_spec/
lib/src/api/generated/

# build_runner outputs from json_serializable / chopper_generator /
# riverpod_generator. Regenerated on every build_runner run.
**/*.g.dart
**/*.chopper.dart
**/*.freezed.dart
.env.local
local.properties

# Signing material — NEVER commit any of these
android/key.properties
android/app/*.jks
android/app/*.keystore
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/Flutter/Release.xcconfig
ios/Flutter/Debug.xcconfig
ios/Pods/
ios/Podfile.lock
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest

# OS / editor
.DS_Store
Thumbs.db

# Review screenshots from test/goldens (regenerated on demand)
test/goldens/out/
